# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca commite.

# Task 10 — URL /exec do App da Web do Apps Script (scripts/Code.gs).
# É o endpoint ÚNICO: atende RSVP, catálogo e status. Substitui o
# PUBLIC_RSVP_ENDPOINT da task 06. Ver README-backend.md.
PUBLIC_BACKEND_URL=

# Task 07 — chave Pix que recebe os presentes.
# Sugestão: use uma chave ALEATÓRIA dedicada ao casamento, não CPF nem telefone
# pessoal. Ela aparece no HTML publicado (é inerente ao BR Code estático), e uma
# chave aleatória pode ser apagada depois sem mexer na conta.
PUBLIC_PIX_CHAVE=
PUBLIC_PIX_NOME=
PUBLIC_PIX_CIDADE=BELEM