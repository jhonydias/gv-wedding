---
import QRCode from 'qrcode';
import { Image } from 'astro:assets';
import { PRESENTES, FAIXAS, PIX, emReais } from '../data/presentes';
import { brCode, txidDe } from '../lib/pix';
import amp from '../assets/marca/e-comercial.svg?raw';
import manifesto from '../data/imagens.json';

const configurado = PIX.chave.length > 0 && PIX.nome.length > 0;

/**
 * Imagens baixadas por `node tools/imagens.mjs`. O manifesto mapeia slug → arquivo
 * local; slug ausente significa que não havia URL ou o download falhou, e o card cai
 * para o placeholder da marca — nunca uma <img> quebrada.
 */
const arquivos = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/fotos/presentes/*.{jpg,jpeg,png,webp,gif}',
    { eager: true },
);

const imagemDe = (slug: string): ImageMetadata | null => {
    const nome = (manifesto as Record<string, string>)[slug];
    if (!nome) return null;
    const chave = Object.keys(arquivos).find((k) => k.endsWith(`/${nome}`));
    return chave ? (arquivos[chave]?.default ?? null) : null;
};

/**
 * QR gerado NO BUILD, como SVG inline.
 *
 * Nada de API externa de geração de QR: colocaria a chave Pix dos noivos na URL de um
 * terceiro, e o QR sumiria se o serviço saísse do ar. A lib fica só em devDependencies —
 * nenhum byte dela vai para o cliente, o que sai é SVG estático.
 */
const itens = configurado
    ? await Promise.all(
          PRESENTES.map(async (p) => {
              const codigo = brCode({
                  chave: PIX.chave,
                  nome: PIX.nome,
                  cidade: PIX.cidade,
                  // Valor livre (task 22 §5.4): BR Code sem valor, o convidado digita no banco.
                  valor: p.valorLivre ? undefined : p.valor,
                  txid: txidDe(p.slug),
              });
              const qr = await QRCode.toString(codigo, {
                  type: 'svg',
                  errorCorrectionLevel: 'M',
                  margin: 4, // quiet zone de 4 módulos
                  color: { dark: '#48492A', light: '#F7F1EB' },
              });
              return { ...p, codigo, qr };
          }),
      )
    : [];
---

{
    !configurado && (
        <p class="aviso" role="alert">
            <strong>Pix não configurado.</strong> Defina <code>PUBLIC_PIX_CHAVE</code> e{' '}
            <code>PUBLIC_PIX_NOME</code> no ambiente. Veja <code>.env.example</code>.
        </p>
    )
}

{
    FAIXAS.map((faixa) => {
        const daFaixa = itens.filter((i) => i.faixa === faixa.id);
        if (daFaixa.length === 0) return null;
        return (
            <section class="faixa" aria-labelledby={`faixa-${faixa.id}`}>
                <h2 class="faixa__titulo" id={`faixa-${faixa.id}`}>
                    {faixa.titulo}
                </h2>
                <p class="faixa__apoio">{faixa.apoio}</p>

                <ul class="grade">
                    {daFaixa.map((p, i) => (
                        <li
                            class="presente"
                            id={p.slug}
                            data-presente-id={p.slug}
                            data-revela
                            style={`--atraso:${Math.min(i, 4) * 70}ms`}
                        >
                            <div class="presente__foto">
                                {imagemDe(p.slug) ? (
                                    <Image
                                        src={imagemDe(p.slug)!}
                                        alt={p.nome}
                                        width={600}
                                        widths={[300, 600]}
                                        sizes="(max-width: 40rem) 90vw, 300px"
                                        loading="lazy"
                                        decoding="async"
                                        quality={70}
                                    />
                                ) : (
                                    <span class="presente__marca" aria-hidden="true" set:html={amp} />
                                )}
                            </div>

                            <div class="presente__corpo">
                                <h3 class="presente__nome">{p.nome}</h3>
                                {p.descricao && <p class="presente__desc">{p.descricao}</p>}
                                <p class="presente__valor tabular">
                                    {p.valorLivre ? `A partir de ${emReais(p.valor)}` : emReais(p.valor)}
                                </p>

                                {/*
                                    Cotas e disponibilidade (task 14 §1.5). O texto inicial só
                                    aparece quando há mais de uma cota; o `status.ts` o
                                    substitui por "restam N de M" se o backend responder.
                                    Se a rede falhar, fica como está: nunca inventar número.
                                */}
                                <p
                                    class="presente__cotas"
                                    data-cotas
                                    data-total={p.cotas}
                                    hidden={p.cotas <= 1}
                                >
                                    {p.cotas} cotas disponíveis
                                </p>

                                <button
                                    type="button"
                                    class="botao botao--primario presente__botao"
                                    data-presente
                                    data-id={p.slug}
                                    data-livre={p.valorLivre ? '' : undefined}
                                    data-minimo={p.valor}
                                    data-nome={p.nome}
                                    data-valor={p.valorLivre ? `A partir de ${emReais(p.valor)}` : emReais(p.valor)}
                                    data-codigo={p.codigo}
                                    data-qr={p.qr}
                                >
                                    Presentear
                                </button>
                            </div>
                        </li>
                    ))}
                </ul>
            </section>
        );
    })
}

<dialog id="pix" class="pix" aria-labelledby="pix-titulo">
    <button class="pix__fechar" type="button" data-fechar aria-label="Fechar">&times;</button>

    <h2 class="pix__titulo" id="pix-titulo" data-pix-nome></h2>
    <p class="pix__valor tabular" data-pix-valor></p>

    {/*
        Task 22: etapa 1, os dados, e daí o checkout do Mercado Pago. method="dialog":
        fora de um <dialog> não navegaria, e dentro dele só fecha, nunca faz GET com os
        dados na URL se o script ainda não carregou.
    */}
    <form class="pag" data-etapa-dados method="dialog" novalidate hidden>
        <div class="pag__campo" data-campo-valor hidden>
            <label for="pag-valor">Quanto você quer dar? (R$)</label>
            <input
                id="pag-valor"
                name="valor"
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                aria-describedby="pag-valor-ajuda"
            />
            <p class="pag__ajuda" id="pag-valor-ajuda" data-valor-ajuda></p>
        </div>
        <div class="pag__campo">
            <label for="pag-nome">Seu nome</label>
            <input id="pag-nome" name="nome" type="text" maxlength="80" autocomplete="name" required aria-describedby="pag-nome-ajuda" />
            <p class="pag__ajuda" id="pag-nome-ajuda">Para os noivos saberem que foi você.</p>
        </div>
        <div class="pag__campo">
            <label for="pag-contato">E-mail ou celular <span class="pag__opcional">(opcional)</span></label>
            <input id="pag-contato" name="contato" type="text" maxlength="120" autocomplete="email" />
        </div>
        <div class="pag__campo">
            <label for="pag-recado">Recado para os noivos <span class="pag__opcional">(opcional)</span></label>
            <textarea id="pag-recado" name="recado" rows="3" maxlength="280"></textarea>
        </div>
        {/* Honeypot: fora da tela e do leitor de tela. Bot preenche, gente não vê. */}
        <input class="pag__mel" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="pag__erro" data-pag-erro role="alert" hidden></p>

        <button type="submit" class="botao botao--primario pag__ir" data-ir>Ir para o pagamento</button>
        <p class="pag__apoio">Você vai para o Mercado Pago: cartão em até 12x, Pix ou saldo.</p>
        <button type="button" class="pag__link" data-pix-direto>Prefere Pix direto?</button>
    </form>

    {/* Etapa Pix: plano B (task 22 §7.5), ou o caminho padrão com o Mercado Pago desligado. */}
    <div data-etapa-pix>
    <p class="pag__aviso" data-pix-aviso hidden>
        Neste caminho a confirmação não é automática: o presente pode continuar aparecendo na
        lista por um tempo.
    </p>
    <p class="pag__aviso" data-pix-livre hidden>Digite o valor no app do banco.</p>

    <div class="pix__qr" data-pix-qr aria-hidden="true"></div>

    <p class="pix__rotulo">Ou copie o código Pix:</p>
    <code class="pix__codigo" data-pix-codigo></code>

    <button class="botao botao--primario pix__copiar" type="button" data-copiar>
        Copiar código Pix
    </button>
    <p class="pix__copiado" data-copiado aria-live="polite"></p>
    </div>
</dialog>

<script>
    import { modalPresente } from '../lib/checkout';
    import { aplicarStatus } from '../lib/status';

    // A disponibilidade chega do backend e diz também se o pagamento é pelo Mercado Pago.
    // Se falhar, a página fica como está e o modal tenta o checkout mesmo assim.
    const status = aplicarStatus();
    modalPresente(status);
</script>

<style>
    .faixa + .faixa {
        margin-block-start: var(--e-5);
    }
    .faixa__titulo {
        font-size: var(--t-xl);
    }
    .faixa__apoio {
        margin-block: 0.2em var(--e-3);
        font-size: var(--t-xs);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--texto-suave);
    }

    /*
     * 15rem, não 13rem: com a foto quadrada e dominante, a coluna estreita espremia o
     * produto de volta ao tamanho de selo. O `gap` sobe para --e-3 porque agora os cards
     * têm sombra, e com 16px as sombras dos vizinhos se encostavam.
     */
    .grade {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
        gap: var(--e-3);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /*
     * O card usa --raio-produto, e é junto com o modal Pix a ÚNICA superfície do site
     * autorizada a isso (tokens.css). `overflow: hidden` é o que faz a foto respeitar os
     * cantos de cima, já que ela sangra até a borda.
     */
    .presente {
        /* Link direto (/presentes#geladeira, "Tentar de novo" do retorno): não parar sob a nav fixa. */
        scroll-margin-block-start: 6rem;
        display: flex;
        flex-direction: column;
        background: var(--bg-alt);
        border: 1px solid var(--borda);
        border-radius: var(--raio-produto);
        overflow: hidden;
        box-shadow:
            0 1px 2px color-mix(in srgb, var(--oliva) 8%, transparent),
            0 6px 18px color-mix(in srgb, var(--oliva) 7%, transparent);
        transition: box-shadow var(--dur-media) var(--ease-saida);
    }
    .presente:hover,
    .presente:focus-within {
        box-shadow:
            0 2px 4px color-mix(in srgb, var(--oliva) 10%, transparent),
            0 14px 32px color-mix(in srgb, var(--oliva) 12%, transparent);
    }

    /*
     * FLEX, não grid. Mesma causa raiz da task 11 §2.2: com `place-items: center` a faixa
     * da grade é dimensionada pelo conteúdo, o bloco contendo da imagem fica com altura
     * indefinida e o `block-size: 100%` dela é descartado. Medido antes da correção:
     * a foto renderizava 188,8×170,4 num slot de 188,8×141,6 e **28,8px eram cortados**
     * (16,9% da imagem), 55px em 470px de viewport. O `object-fit: contain` nunca chegava
     * a atuar, porque a caixa da imagem não estava limitada em altura.
     *
     * Quadrado, não 4/3: foto de e-commerce é quase sempre quadrada, e o 4/3 deitado
     * desperdiçava altura no eixo em que o produto costuma ser mais alto.
     *
     * Fundo BRANCO de propósito: as fotos são recortes de marketplace sobre branco puro.
     * Sobre creme ou areia, o que aparecia era o retângulo branco da foto, não o produto.
     * Assumindo o branco, o plano se funde com a foto e sobra só o objeto. Funciona para
     * qualquer foto de loja e não depende de recorte manual (task 14 §4.2).
     */
    .presente__foto {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 1 / 1;
        padding: var(--e-2);
        overflow: hidden;
        background: #fff;
    }
    .presente__foto :global(img) {
        max-inline-size: 100%;
        max-block-size: 100%;
        inline-size: auto;
        block-size: auto;
        /* `contain`: são fotos de produto com fundo branco. `cover` cortaria o objeto. */
        object-fit: contain;
        transition: scale var(--dur-media) var(--ease-saida);
    }
    .presente:hover .presente__foto :global(img),
    .presente:focus-within .presente__foto :global(img) {
        /* Mesmo valor da galeria e dos atalhos: só `scale`, nada que recalcule layout. */
        scale: 1.04;
    }

    .presente__corpo {
        display: flex;
        flex-direction: column;
        flex: 1;
        gap: 0.3rem;
        padding: var(--e-3);
    }

    /* Placeholder da marca: sem URL na planilha, ou download que falhou. */
    .presente__marca {
        display: block;
        inline-size: 2.5rem;
        color: color-mix(in srgb, var(--laranja) 55%, transparent);
    }
    .presente__marca :global(svg) {
        inline-size: 100%;
        height: auto;
    }
    .presente__nome {
        font-size: var(--t-lg);
        text-transform: none;
    }
    .presente__desc {
        font-size: var(--t-xs);
        color: var(--texto-suave);
    }
    .presente__valor {
        font-family: var(--fonte-display);
        font-size: var(--t-lg);
    }
    /* Sinal de escassez, não alarme: mesmo corpo da descrição, sem cor de alerta. */
    .presente__cotas {
        font-size: var(--t-xs);
        letter-spacing: 0.06em;
        color: var(--texto-suave);
    }
    .presente__botao {
        /* `auto` empurra o botão para o rodapé do card, alinhando os botões de todas as
           colunas mesmo com descrições de alturas diferentes. */
        margin-block-start: auto;
        inline-size: 100%;
        /* O botão DENTRO do card de produto acompanha o card. Os outros botões do site
           continuam em --raio (tokens.css). */
        border-radius: var(--raio-produto);
    }

    /* Presente já dado: marcado, não escondido. */
    /*
     * Presente já dado: marcado, não escondido (task 07). Quem recebeu o link de um item
     * específico precisa entender o que houve, e não achar que a página quebrou.
     * Perde a elevação: fica no plano, sem convidar ao clique.
     */
    .presente[data-indisponivel] {
        background: color-mix(in srgb, var(--bg-alt) 55%, var(--bg));
        box-shadow: none;
    }
    .presente[data-indisponivel] .presente__foto {
        opacity: 0.55;
    }
    .presente[data-indisponivel]:hover .presente__foto :global(img),
    .presente[data-indisponivel]:focus-within .presente__foto :global(img) {
        scale: 1;
    }
    .presente[data-indisponivel] .presente__nome,
    .presente[data-indisponivel] .presente__valor {
        text-decoration: line-through;
        text-decoration-thickness: 1px;
        color: var(--texto-suave);
    }
    /* Reservado (task 22): alguém está pagando a última cota. Sem riscar, pode voltar. */
    .presente[data-reservado] {
        box-shadow: none;
    }

    .presente__botao:disabled {
        background: transparent;
        border: 1px solid var(--borda);
        color: var(--texto-suave);
        cursor: default;
        text-transform: none;
        letter-spacing: 0;
    }

    .aviso {
        margin-block-end: var(--e-3);
        padding: var(--e-2);
        border: 1px solid var(--laranja-texto);
        border-radius: var(--raio);
        color: var(--laranja-texto);
        font-size: var(--t-sm);
    }

    /* --- Modal --- */
    .pix {
        inline-size: min(92vw, 26rem);
        padding: var(--e-4);
        border: 0;
        /* Continua o mesmo objeto do card: acompanha --raio-produto (tokens.css). */
        border-radius: var(--raio-produto);
        background: var(--creme);
        color: var(--oliva);
        text-align: center;
    }
    /* Com a etapa de dados (task 22) o modal cresce: rola por dentro em tela baixa. */
    .pix {
        max-block-size: 92svh;
        overflow-y: auto;
    }
    .pix::backdrop {
        background: color-mix(in srgb, #48492a 88%, transparent);
        backdrop-filter: blur(6px);
    }

    .pix__fechar {
        position: absolute;
        inset-block-start: var(--e-1);
        inset-inline-end: var(--e-1);
        inline-size: 44px;
        block-size: 44px;
        background: none;
        border: 0;
        color: var(--oliva);
        font-size: 1.5rem;
        cursor: pointer;
    }

    .pix__titulo {
        font-size: var(--t-lg);
        text-transform: none;
    }
    .pix__valor {
        margin-block: 0.2em var(--e-3);
        font-family: var(--fonte-display);
        font-size: var(--t-xl);
    }

    .pix__qr {
        inline-size: 220px;
        block-size: 220px;
        margin-inline: auto;
    }
    .pix__qr :global(svg) {
        inline-size: 100%;
        block-size: 100%;
    }

    .pix__rotulo {
        margin-block-start: var(--e-3);
        font-size: var(--t-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--texto-suave);
    }

    .pix__codigo {
        display: block;
        margin-block: 0.4rem var(--e-2);
        padding: 0.6rem;
        max-block-size: 6rem;
        overflow-y: auto;
        background: var(--areia);
        border-radius: var(--raio);
        font-family: ui-monospace, monospace;
        font-size: 0.72rem;
        line-height: 1.4;
        word-break: break-all;
        text-align: start;
        /* Selecionável à mão, sempre — o fallback do fallback. */
        user-select: all;
    }

    .pix__copiar {
        inline-size: 100%;
    }
    .pix__copiado {
        min-block-size: 1.4em;
        margin-block-start: 0.4rem;
        font-size: var(--t-xs);
        font-weight: 600;
        color: var(--laranja-texto);
    }
    /* --- Etapa de dados (task 22) --- */
    .pag {
        display: grid;
        gap: var(--e-2);
        text-align: start;
    }
    .pag__campo {
        display: grid;
        gap: 0.3rem;
    }
    .pag label {
        font-size: var(--t-sm);
        font-weight: 600;
    }
    .pag__opcional {
        font-weight: 400;
        color: var(--texto-suave);
    }
    .pag input,
    .pag textarea {
        inline-size: 100%;
        min-block-size: 44px;
        padding: 0.6rem 0.75rem;
        background: var(--bg);
        border: 1px solid var(--borda);
        border-radius: var(--raio);
        color: var(--texto);
        font-size: 1rem; /* 16px: abaixo disso o iOS dá zoom ao focar */
    }
    .pag textarea {
        resize: vertical;
    }
    .pag input[aria-invalid='true'] {
        border: 2px solid var(--laranja-texto);
    }
    .pag__ajuda,
    .pag__apoio {
        font-size: var(--t-xs);
        color: var(--texto-suave);
    }
    .pag__apoio {
        text-align: center;
    }
    .pag__erro,
    .pag__aviso {
        font-size: var(--t-sm);
        font-weight: 600;
        color: var(--laranja-texto);
    }
    .pag__aviso {
        margin-block-end: var(--e-2);
    }
    .pag__ir {
        inline-size: 100%;
        border-radius: var(--raio-produto);
    }
    .pag__link {
        justify-self: center;
        min-block-size: 44px;
        background: none;
        border: 0;
        color: var(--link);
        font-size: var(--t-sm);
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
    }
    .pag__mel {
        position: absolute;
        inset-inline-start: -9999px;
        inline-size: 1px;
        block-size: 1px;
        opacity: 0;
    }
    .pix [hidden] {
        display: none !important;
    }
</style>
