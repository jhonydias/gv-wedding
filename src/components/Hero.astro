---
import { Image } from 'astro:assets';
import { EVENTO, dataPorExtenso, horaFormatada, DATETIME_ATTR } from '../data/event';
import { HERO, ALT_HERO } from '../data/hero';
import amp from '../assets/marca/e-comercial.svg?raw';

const { local } = EVENTO;

const arquivos = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/fotos/*.{jpg,jpeg,png,webp}',
    { eager: true },
);

const imagemDe = (nome: string): ImageMetadata | null => {
    const chave = Object.keys(arquivos).find((k) => k.endsWith(`/${nome}`));
    return chave ? (arquivos[chave]?.default ?? null) : null;
};

/**
 * ⚠️ Não ler `imagem.width`/`imagem.height` aqui nem no markup. A task 11 §3.2 mediu que
 * tocar nessas propriedades do ImageMetadata faz o Astro emitir os JPEGs ORIGINAIS no
 * dist: 159 arquivos em vez de 124, o maior com 734 KB contra o teto de 250 KB.
 */
const primeira = imagemDe(HERO[0]!.arquivo);
const extras = HERO.slice(1)
    .map((f) => ({ ...f, imagem: imagemDe(f.arquivo) }))
    .filter((f): f is typeof f & { imagem: ImageMetadata } => f.imagem !== null);
---

<section class="hero" aria-labelledby="hero-titulo">
    <div class="hero__fundo" data-hero-fundo>
        {
            primeira && (
                <Image
                    class="hero__foto hero__foto--ativa"
                    src={primeira}
                    alt={ALT_HERO}
                    widths={[640, 1024, 1600]}
                    width={1024}
                    sizes="(max-width: 48rem) 150vw, 100vw"
                    loading="eager"
                    fetchpriority="high"
                    quality={62}
                    style={`object-position: ${HERO[0]!.foco}`}
                />
            )
        }

        {/*
            As demais ficam dentro de <template> (task 13 §1).
            Conteúdo de <template> é inerte: o parser NÃO baixa essas imagens. É a única
            forma de garantir que a primeira tela carregue UMA foto, já que `loading="lazy"`
            não adia nada aqui — o hero ocupa a viewport inteira, e imagem dentro da
            viewport com lazy é baixada na hora.

            O `src/lib/hero.ts` clona uma de cada vez, depois do `load`, e só troca quando a
            próxima terminou de baixar. A margem de 40 ms que a home tem no orçamento de LCP
            (task 02 §6) não sobrevive a uma segunda foto no caminho crítico.
        */}
        <template data-hero-extras>
            {extras.map((f) => (
                <Image
                    class="hero__foto"
                    src={f.imagem}
                    alt=""
                    aria-hidden="true"
                    widths={[640, 1024, 1600]}
                    width={1024}
                    sizes="(max-width: 48rem) 150vw, 100vw"
                    loading="lazy"
                    decoding="async"
                    quality={62}
                    style={`object-position: ${f.foco}`}
                />
            ))}
        </template>
    </div>

    <script>
        import { heroFotos } from '../lib/hero';
        heroFotos();
    </script>

    <div class="hero__conteudo wrap" data-hero-conteudo>
        {/*
            Revelação por LINHA, não por letra. Quebrar um didone de 8rem em um
            inline-block por caractere destrói o kerning e o entrelinhamento — o efeito
            some e o defeito aparece. Por palavra vale para títulos de texto corrido
            (ver [data-palavras]), onde cada palavra mantém o kerning interno.
        */}
        <h1 class="hero__nomes" id="hero-titulo">
            <span class="hero__nome" data-revela style="--atraso:80ms">Gisele</span>
            <span class="sr-only"> e </span>
            <span class="hero__amp" aria-hidden="true" data-revela style="--atraso:260ms" set:html={amp} />
            <span class="hero__nome" data-revela style="--atraso:400ms">Victor</span>
        </h1>

        <p class="hero__dados" data-revela style="--atraso:640ms">
            <time datetime={DATETIME_ATTR}>{dataPorExtenso()}, às {horaFormatada()}</time>
            <span class="hero__local">
                {local.nome} · {local.bairro}, {local.cidade}/{local.uf}
            </span>
        </p>
    </div>

    {/*
        Afordância de rolagem, não texto. Aqui havia a palavra "role" em caixa alta com
        `letter-spacing: 0.3em`, que se lê "ROLE" ou "rolê" antes de se ler "role a página"
        (task 12 §1). O papel de sinalizar que o hero de 100svh continua abaixo da dobra
        permanece; a palavra, não.

        Decorativo: `aria-hidden` fica, e isto NÃO vira <button> nem <a>. Se um dia virar
        navegação de verdade, precisa de nome acessível, alvo de 44px e foco visível.
    */}
    <span class="hero__rolar" aria-hidden="true">
        <svg
            viewBox="0 0 28 10"
            width="28"
            height="10"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M1 1 14 9 27 1" />
        </svg>
    </span>
</section>

<style>
    .hero {
        position: relative;
        /* `svh`, não `vh`: em iOS a barra do Safari faz 100vh estourar a tela. */
        min-block-size: 100svh;
        display: grid;
        place-items: center;
        overflow: hidden;
        color: var(--creme);
        text-align: center;
    }

    /*
     * A foto cobre a viewport inteira, em TODOS os tamanhos.
     *
     * O `sizes` pede 150vw abaixo de 48rem de propósito: a foto é 2:3 e a caixa no
     * celular é bem mais estreita que isso, então o `object-fit: cover` amplia a imagem
     * para cobrir a altura e recorta as laterais. Pedir só 100vw entregaria uma variante
     * pequena demais e a foto sairia borrada.
     */
    .hero__fundo {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    /*
     * As fotos ficam EMPILHADAS e a fusão é só em `opacity` (task 02 §5: nada que dispare
     * layout). O scrim é o `::after` deste contêiner, então continua único e por cima de
     * todas: não duplicar escurecimento por camada.
     *
     * `linear`, e não o `--ease-saida`: numa fusão cruzada, curva com aceleração faz as
     * duas imagens ficarem em opacidade intermediária ao mesmo tempo e a soma cai, abrindo
     * um vale de luminosidade no meio da troca. Linear mantém o brilho estável.
     *
     * `object-position` vem por foto, no atributo `style`, e não daqui: cada quadro tem o
     * casal numa altura diferente (ver src/data/hero.ts).
     */
    .hero__fundo :global(.hero__foto) {
        position: absolute;
        inset: 0;
        inline-size: 100%;
        block-size: 100%;
        /* Nada de max-block-size aqui: era o que travava a foto em 544px e deixava
           uma faixa de fundo exposta embaixo no mobile. */
        object-fit: cover;
        opacity: 0;
        transition: opacity 1400ms linear;
    }

    /*
     * A primeira nasce ativa NO HTML, não pelo JS: com JS desligado, lento ou quebrado, o
     * hero aparece completo e com a foto certa.
     */
    .hero__fundo :global(.hero__foto--ativa) {
        opacity: 1;
    }

    /*
     * Movimento reduzido: sem transição. O `hero.ts` já sai antes de instalar qualquer
     * timer, então não há troca nenhuma; isto é a segunda linha de defesa, para o caso de
     * a classe ser trocada por outro caminho.
     */
    @media (prefers-reduced-motion: reduce) {
        .hero__fundo :global(.hero__foto) {
            transition: none;
        }
    }

    /*
     * Escurecimento em DUAS camadas.
     *
     * Medido: com só o gradiente linear, o contraste do texto creme sobre a foto composta
     * caía a 2.00:1 nos pontos claros (céu e pedra da catedral) — reprova em AA, mesmo com
     * média de 5:1. Um alpha uniforme de 0.80 resolveria, mas apagaria a foto.
     *
     * Solução: um scrim radial concentrado atrás do texto, sobre o gradiente linear. Nas
     * bordas só o linear atua e a foto continua vívida.
     *
     * Os valores do scrim NÃO são estéticos, são calculados: com 0.72/0.45 o pior caso
     * ficava em 3.65:1 — suficiente para os nomes (texto grande, teto 3:1) mas NÃO para a
     * linha de data, que é pequena e exige 4.5:1. Com 0.86/0.66 o pior caso vai a 4.85:1
     * e a página inteira passa em AA.
     */
    .hero__fundo::after {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 92% 66% at 50% 50%,
                color-mix(in srgb, var(--oliva) 86%, transparent) 0%,
                color-mix(in srgb, var(--oliva) 66%, transparent) 55%,
                transparent 80%
            ),
            linear-gradient(
                180deg,
                color-mix(in srgb, var(--oliva) 78%, transparent) 0%,
                color-mix(in srgb, var(--oliva) 42%, transparent) 38%,
                color-mix(in srgb, var(--oliva) 55%, transparent) 70%,
                color-mix(in srgb, var(--oliva) 88%, transparent) 100%
            );
    }

    .hero__conteudo {
        position: relative;
        z-index: 1;
        padding-block: var(--e-6);
        /* Movido pelo JS conforme a rolagem (fade + deriva). */
        will-change: opacity, transform;
    }

    .hero__nomes {
        font-size: var(--t-3xl);
        line-height: 0.9;
        margin: 0;
        text-shadow: 0 1px 24px color-mix(in srgb, var(--oliva) 60%, transparent);
    }
    .hero__nome {
        display: block;
    }

    .hero__amp {
        display: block;
        inline-size: clamp(3.5rem, 11vw, 8rem);
        margin-inline: auto;
        margin-block: -0.1em;
        color: var(--laranja);
    }
    .hero__amp :global(svg) {
        inline-size: 100%;
        height: auto;
    }

    .hero__dados {
        margin-block-start: var(--e-4);
        font-size: var(--t-sm);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--creme) 88%, transparent);
    }
    .hero__local {
        display: block;
        margin-block-start: 0.5em;
    }

    /*
     * Seta fina, larga e rasa (28×10 com traço de 1px): a proporção deitada é o que a
     * mantém discreta. Um chevron alto e grosso vira ícone de app e briga com o didone
     * dos nomes.
     */
    .hero__rolar {
        position: absolute;
        z-index: 1;
        inset-block-end: var(--e-3);
        inset-inline-start: 50%;
        translate: -50% 0;
        color: color-mix(in srgb, var(--creme) 70%, transparent);
    }
    .hero__rolar :global(svg) {
        display: block;
    }

    /*
     * A media query de movimento vem ANTES da animação, não depois (regra 3 do README das
     * tasks): sem `no-preference`, quem pediu movimento reduzido dependeria do bloco de
     * `motion.css` para desligar isto, e o estado final ficaria por acaso.
     *
     * Anima só `translate`, nunca `inset-block-end` (task 02 §5). O `-50%` do eixo em linha
     * é repetido em cada quadro porque ele também centraliza o elemento: perdê-lo joga a
     * seta para a direita.
     *
     * `ease-in-out`, e não o `--ease-saida`: aquela curva desacelera forte no fim, o que é
     * certo para uma entrada única e errado para um ciclo, onde vira solavanco. O repouso
     * de 40% do ciclo é o que faz respirar em vez de pular.
     */
    @media (prefers-reduced-motion: no-preference) {
        .hero__rolar {
            animation: hero-descer 2.6s ease-in-out infinite;
        }
    }

    @keyframes hero-descer {
        0%,
        60%,
        100% {
            translate: -50% 0;
        }
        30% {
            translate: -50% 6px;
        }
    }

    @media (max-width: 40rem) {
        .hero__dados {
            font-size: var(--t-xs);
        }
    }
</style>
