---
/**
 * Layout base — task 02 §4 e §7, com a nav da task 03.
 */
// Só o eixo de peso, normal (sem itálico). Cada @font-face traz unicode-range, então o
// browser baixa apenas o subset latino — os demais ficam no dist mas nunca são transferidos.
import '@fontsource-variable/bodoni-moda/wght.css';
import '@fontsource-variable/inter/wght.css';

/*
 * Preload do subset latino das duas fontes.
 *
 * Sem isso, o `font-display: swap` renderiza primeiro na fonte de fallback e troca
 * quando a webfont chega — e a troca muda as métricas do texto. O Lighthouse mediu
 * CLS 0.142 em /historia por exatamente isso, apontando o
 * `bodoni-moda-latin-wght-normal.woff2` como causa do deslocamento.
 *
 * As DUAS fontes, e o trade-off foi medido:
 *
 *   preload dos dois  ->  CLS 0.000 em todas as páginas  ·  LCP da home 2.78s
 *   só o Bodoni       ->  CLS 0.095 em /historia         ·  LCP da home 1.97s
 *
 * O Inter é que zera o CLS restante (a troca da fonte de corpo). CLS tem teto rígido de
 * 0.05 e texto pulando é visível para quem lê; 0.8s a mais em 4G simulado, não.
 * ~72 KB somados, usados em toda página e acima da dobra.
 */
import bodoniLatin from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

import Nav from '../components/Nav.astro';
import Rodape from '../components/Rodape.astro';
import { EVENTO, dataPorExtenso } from '../data/event';
import { rota } from '../lib/url';

interface Props {
    titulo: string;
    descricao?: string;
    /** Rota atual, sem base. Governa o aria-current da nav. */
    atual: string;
    /** Nav transparente sobre um hero escuro (só na home). */
    heroEscuro?: boolean;
    /**
     * Marca a página como não indexável. Usado por páginas ainda sem conteúdo
     * (ex.: /historia enquanto HISTORIA estiver vazio). A exclusão do sitemap
     * propriamente dita é da task 09, que ainda não gera sitemap.
     */
    naoIndexar?: boolean;
}

const { titulo, descricao, atual, heroEscuro = false, naoIndexar = false } = Astro.props;

const descricaoPadrao =
    `${EVENTO.noiva} e ${EVENTO.noivo} se casam em ${dataPorExtenso()}, ` +
    `no ${EVENTO.local.nome}, em ${EVENTO.local.cidade}. Confirme sua presença.`;

const canonica = new URL(Astro.url.pathname, Astro.site);
const ogImagem = new URL(rota('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <link rel="preload" as="font" type="font/woff2" href={bodoniLatin} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
        <title>{titulo}</title>
        <meta name="description" content={descricao ?? descricaoPadrao} />
        <link rel="canonical" href={canonica.href} />
        {naoIndexar && <meta name="robots" content="noindex, follow" />}

        <link rel="icon" type="image/svg+xml" href={rota('/favicon.svg')} />
        <link rel="apple-touch-icon" href={rota('/apple-touch-icon.png')} />
        <meta name="theme-color" content="#48492A" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={descricao ?? descricaoPadrao} />
        <meta property="og:image" content={ogImagem.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="pt_BR" />
        <meta name="twitter:card" content="summary_large_image" />

        <meta name="generator" content={Astro.generator} />
    </head>

    <body>
        <a class="pular" href="#conteudo">Pular para o conteúdo</a>

        <Nav atual={atual} sobreEscuro={heroEscuro} />

        <main id="conteudo">
            <slot />
        </main>

        <Rodape />

        <script>
            import { revelar } from '../lib/revelar';
            import { nav } from '../lib/nav';
            import { tipografiaAnimada, heroScroll } from '../lib/texto';

            nav();
            revelar();
            tipografiaAnimada();
            heroScroll();
        </script>
    </body>
</html>
