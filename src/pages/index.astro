---
/**
 * PÁGINA DE TESTE DO SISTEMA — descartável.
 *
 * A task 02 entrega o SISTEMA, não conteúdo. Esta página existe só para provar que
 * tokens, escala tipográfica, grid, sangramento, inversão de seção e o motor de
 * revelação funcionam.
 *
 * A task 03 SUBSTITUI este arquivo pela home de verdade. Não construa em cima dele.
 */
import Base from '../layouts/Base.astro';
import { EVENTO, dataPorExtenso, horaFormatada, DATETIME_ATTR } from '../data/event';
import logo from '../assets/marca/logo-reduzido.svg?raw';
import amp from '../assets/marca/e-comercial.svg?raw';

const escala = [
    ['--t-3xl', 'Nomes no hero'],
    ['--t-2xl', 'Título de seção'],
    ['--t-xl', 'Subtítulo'],
    ['--t-lg', 'Destaque'],
    ['--t-base', 'Corpo'],
    ['--t-sm', 'Apoio'],
    ['--t-xs', 'Legenda'],
] as const;

const cores = [
    ['--oliva', '#48492A', 'Âncora'],
    ['--creme', '#F7F1EB', 'Fundo padrão'],
    ['--areia', '#EDDEC9', 'Faixa alternada'],
    ['--laranja', '#F0994A', 'Acento / botão'],
    ['--lilas', '#9B87A2', 'Acento secundário'],
    ['--sage', '#AFB06A', 'Superfície'],
    ['--tinta', '#1A1A1A', 'Texto sobre cor'],
] as const;
---

<Base titulo="Sistema · Gisele & Victor" descricao="Página de teste do design system.">
    <section class="secao inverso">
        <div class="wrap">
            <p class="rotulo">Task 02 · página de teste (será substituída pela task 03)</p>
            <div class="logo" set:html={logo} />
            <p class="dados">
                <time datetime={DATETIME_ATTR}>{dataPorExtenso()}, às {horaFormatada()}</time><br />
                {EVENTO.local.nome} · {EVENTO.local.bairro}, {EVENTO.local.cidade}/{EVENTO.local.uf}
            </p>
        </div>
    </section>

    <section class="secao">
        <div class="wrap">
            <h2>Cor</h2>
            <div class="amostras">
                {cores.map(([token, hex, papel]) => (
                    <div class="amostra">
                        <div class="amostra__chip" style={`background:${hex}`}></div>
                        <code>{token}</code>
                        <span>{hex}</span>
                        <small>{papel}</small>
                    </div>
                ))}
            </div>

            <h3 style="margin-top:var(--e-4)">Contraste medido</h3>
            <ul class="contraste">
                <li><span class="ok">8.28:1</span> oliva sobre creme — AAA</li>
                <li><span class="ok">8.28:1</span> creme sobre oliva — AAA</li>
                <li><span class="ok">7.77:1</span> <code>--laranja-texto</code> sobre creme — AAA</li>
                <li><span class="ok">7.76:1</span> tinta sobre laranja (botão) — AAA</li>
                <li><span class="mau">4.14:1</span> oliva sobre laranja — reprova em AA</li>
                <li><span class="mau">2.00:1</span> laranja sobre creme — reprova em AA</li>
            </ul>
        </div>
    </section>

    <section class="secao alt">
        <div class="wrap">
            <h2>Tipografia</h2>
            {escala.map(([token, papel]) => (
                <p class="linha" style={`font-size:var(${token})`}>
                    <span class="display">Gisele &amp; Victor</span>
                    <code>{token} · {papel}</code>
                </p>
            ))}
            <p class="texto-corpo" style="margin-top:var(--e-3)">
                Corpo de texto na largura de leitura (~68 caracteres). O didone fica no display;
                o grotesco some e deixa a serifa brilhar. Clássico na letra, moderno no layout.
            </p>
        </div>
    </section>

    <section class="secao">
        <div class="wrap">
            <h2>Grid editorial</h2>
            <div class="grid-ed demo">
                <div style="grid-column:1 / 7">1 → 7</div>
                <div style="grid-column:7 / 13">7 → 13</div>
                <div style="grid-column:1 / 5">1 → 5</div>
                <div style="grid-column:5 / 10">5 → 10</div>
                <div style="grid-column:10 / 13">10 → 13</div>
            </div>
        </div>
    </section>

    <section class="secao sobre-sage">
        <div class="wrap">
            <h2>Sangramento</h2>
            <p class="texto-corpo">
                A faixa abaixo está dentro do <code>.wrap</code> e usa <code>.sangra</code> para
                vazar até a borda da viewport — descontando a barra de rolagem, sem overflow
                horizontal. Sobre sage o texto é <code>--tinta</code>: o oliva daria só 4.09:1.
            </p>
            <div class="faixa sangra">100vw − barra de rolagem</div>
        </div>
    </section>

    <section class="secao">
        <div class="wrap">
            <h2>Movimento</h2>
            <p class="texto-corpo">
                Os blocos abaixo entram com <code>data-revela</code>, escalonados. Com
                {' '}<code>prefers-reduced-motion: reduce</code> aparecem prontos, sem animação.
            </p>
            <div class="revelaveis">
                {[0, 1, 2, 3].map((i) => (
                    <div class="bloco" data-revela style={`--atraso:${i * 90}ms`}>{i + 1}</div>
                ))}
            </div>

            <div class="amp" data-revela="cortina" set:html={amp} />

            <p style="margin-top:var(--e-4)">
                <a class="botao botao--primario" href="#conteudo">Botão primário</a>
                <a class="botao botao--fantasma" href="#conteudo">Botão fantasma</a>
            </p>
        </div>
    </section>
</Base>

<style>
    .rotulo {
        font-size: var(--t-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--texto-suave);
        margin-block-end: var(--e-4);
    }

    .logo {
        max-inline-size: 22rem;
    }
    .logo :global(svg) {
        --logo-texto: var(--creme);
        --logo-amp: var(--laranja);
        inline-size: 100%;
        height: auto;
    }

    .dados {
        margin-block-start: var(--e-3);
        font-size: var(--t-sm);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--texto-suave);
    }

    h2 {
        margin-block-end: var(--e-3);
    }

    .amostras {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
        gap: var(--e-2);
    }
    .amostra__chip {
        aspect-ratio: 3 / 2;
        border: 1px solid var(--borda);
        border-radius: var(--raio);
        margin-block-end: var(--e-1);
    }
    .amostra code {
        display: block;
        font-size: var(--t-xs);
    }
    .amostra span,
    .amostra small {
        display: block;
        font-size: var(--t-xs);
        color: var(--texto-suave);
    }

    .contraste {
        list-style: none;
        padding: 0;
        font-size: var(--t-sm);
    }
    .contraste li {
        padding-block: 0.15rem;
    }
    .contraste .ok,
    .contraste .mau {
        display: inline-block;
        min-inline-size: 5rem;
        font-variant-numeric: tabular-nums;
        font-weight: 600;
    }
    .contraste .ok {
        color: var(--laranja-texto);
    }
    .contraste .mau {
        color: #a11;
    }

    .linha {
        display: flex;
        align-items: baseline;
        gap: var(--e-2);
        border-block-end: 1px solid var(--borda);
        padding-block: var(--e-1);
        line-height: 1.1;
    }
    .linha code {
        font-size: var(--t-xs);
        color: var(--texto-suave);
        white-space: nowrap;
    }

    .faixa {
        margin-block-start: var(--e-3);
        padding: var(--e-3);
        background: var(--oliva);
        color: var(--creme);
        text-align: center;
        font-size: var(--t-sm);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .demo > * {
        background: var(--areia);
        padding: var(--e-2);
        font-size: var(--t-xs);
        text-align: center;
        border-radius: var(--raio);
    }

    .revelaveis {
        display: flex;
        gap: var(--e-2);
        margin-block-start: var(--e-3);
        flex-wrap: wrap;
    }
    .bloco {
        display: grid;
        place-items: center;
        inline-size: 5rem;
        aspect-ratio: 1;
        background: var(--oliva);
        color: var(--creme);
        font-family: var(--fonte-display);
        font-size: var(--t-lg);
        border-radius: var(--raio);
    }

    .amp {
        margin-block-start: var(--e-4);
        max-inline-size: 7rem;
        color: var(--laranja);
    }
    .amp :global(svg) {
        inline-size: 100%;
        height: auto;
    }

    .botao + .botao {
        margin-inline-start: var(--e-1);
    }
</style>
