---
import Base from '../layouts/Base.astro';
import ComoChegar from '../components/ComoChegar.astro';
import { EVENTO, dataPorExtenso, horaFormatada, DATETIME_ATTR } from '../data/event';
import IconeApp from '../components/IconeApp.astro';
import { buscaNoMapa } from '../lib/mapas';
import { TRAJE, LOJA, instagramDe } from '../data/traje';

const { local } = EVENTO;

const mapaLoja = buscaNoMapa(LOJA.nome, `${LOJA.logradouro}, ${LOJA.cidade} - ${LOJA.uf}`);

/**
 * Rotas por origem. Estrutura copiada da referência, adaptada a Belém.
 * TODO(factual): confirmar as origens prováveis e os tempos com os noivos.
 */
const ORIGENS = [
    { de: 'Do aeroporto (Val-de-Cans)', obs: 'TODO: tempo estimado e referência de chegada' },
    { de: 'De Nazaré, Batista Campos ou Reduto', obs: 'Bairros vizinhos ao Umarizal' },
    { de: 'De Ananindeua ou Marituba', obs: 'TODO: tempo estimado' },
    { de: 'Do centro ou da Cidade Velha', obs: 'TODO: tempo estimado' },
] as const;
---

<Base
    titulo="Informações · Gisele & Victor"
    descricao="Local, como chegar, traje e hospedagem para o casamento de Gisele e Victor."
    atual="/informacoes"
>
    <header class="cabeca inverso">
        <div class="wrap">
            <h1 data-palavras>Informações</h1>
            <p class="cabeca__apoio">Tudo que você precisa saber sobre o grande dia</p>
        </div>
    </header>

    {/*
        Ordem deliberada: "Chamar um carro" vem ANTES do endereço.
        A task 08 §1 listava o local primeiro, mas o critério de aceite pede o bloco de
        corrida visível sem rolar em 360×640 — e com o cabeçalho mais o endereço na frente
        ele caía a 1335px do topo. Os dois requisitos não cabem juntos; o critério ganha.
        Faz sentido: o botão já leva o destino embutido, então o endereço logo abaixo basta.
    */}
    <ComoChegar />

    <!-- Local -->
    <section class="secao" aria-labelledby="local-titulo">
        <div class="wrap">
            <h2 id="local-titulo" data-palavras>O local</h2>
            <p class="local__nome">{local.nome}</p>
            <address class="local__endereco">
                {local.logradouro}<br />
                {local.bairro} · {local.cidade}/{local.uf}<br />
                CEP {local.cep}
            </address>
            <p class="local__quando">
                <time datetime={DATETIME_ATTR}>{dataPorExtenso()}, às {horaFormatada()}</time>
            </p>

            {/*
                Os noivos decidiram em 16/08/2026 NÃO informar horário de término. Por isso
                aqui não há pendência: `termino` é `null` de propósito. Se um dia for
                preenchido em `event.ts`, a linha aparece sozinha.
            */}
            {EVENTO.termino && <p class="local__quando">Até {EVENTO.termino}</p>}
        </div>
    </section>

    <!-- Como chegar -->
    <section class="secao" aria-labelledby="rotas-titulo">
        <div class="wrap">
            <h2 id="rotas-titulo" data-palavras>Como chegar</h2>
            <p class="texto-corpo">
                O espaço fica no próprio Umarizal, então boa parte dos convidados de Belém está a
                poucos minutos.
            </p>

            <ol class="rotas">
                {ORIGENS.map((o) => (
                    <li>
                        <h3>{o.de}</h3>
                        <p>{o.obs}</p>
                    </li>
                ))}
            </ol>

        </div>
    </section>

    <!-- Traje -->
    {/*
        Task 20: o `id` dá o link /informacoes#traje, para mandar no grupo quando alguém
        perguntar o traje. Seção com âncora, e não abas: abas esconderiam conteúdo com JS e
        empurrariam o "Chamar um carro" para fora da primeira tela.
    */}
    <section id="traje" class="secao alt traje" aria-labelledby="traje-titulo">
        <div class="wrap">
            <h2 id="traje-titulo" data-palavras>Traje</h2>
            <p class="traje__codigo">{TRAJE.codigo}</p>

            <h3 class="sub">Sugestão de loja</h3>
            <div class="loja">
                <p class="loja__nome">{LOJA.nome}</p>
                <p class="loja__oferece">{LOJA.oferece}</p>

                <p class="loja__apoio">Desconto para os convidados:</p>
                <ul class="loja__descontos">
                    {LOJA.descontos.map((d) => (
                        <li>
                            <span class="loja__pct">{d.percentual}%</span>
                            <span class="loja__cond">{d.condicao}</span>
                        </li>
                    ))}
                </ul>

                <address class="loja__endereco">
                    {LOJA.logradouro}<br />
                    {LOJA.cidade}/{LOJA.uf}
                </address>

                <p class="loja__links">
                    <a
                        href={instagramDe(LOJA.instagram)}
                        rel="noopener"
                        aria-label={`Instagram da ${LOJA.nome}`}><IconeApp app="instagram" />Instagram</a
                    >
                    <a href={mapaLoja} rel="noopener" aria-label={`Ver no mapa o endereço da ${LOJA.nome}`}
                        ><IconeApp app="googlemaps" />Ver no mapa</a
                    >
                </p>

                <p class="loja__contato">Mais informações, entre em contato com a loja.</p>
            </div>
        </div>
    </section>

    <!-- 5. Hospedagem -->
    <section class="secao" aria-labelledby="hosp-titulo">
        <div class="wrap">
            <h2 id="hosp-titulo" data-palavras>Hospedagem</h2>
            <p class="texto-corpo">
                O Umarizal concentra boa parte da rede hoteleira de Belém, e é o bairro do
                próprio espaço, o que facilita bastante. Por proximidade: Umarizal, depois
                Nazaré, Reduto e Batista Campos.
            </p>
            <p class="pendencia">TODO: os noivos precisam indicar hotéis, e se há bloqueio de
            quartos ou código de desconto. Não listar hotel específico sem confirmação.</p>
        </div>
    </section>

    <!-- 6. Dúvidas -->
    <section class="secao alt" aria-labelledby="duvidas-titulo">
        <div class="wrap duvidas">
            <h2 id="duvidas-titulo" data-palavras>Ficou alguma dúvida?</h2>
            <p class="pendencia">TODO: definir o número de WhatsApp para contato. Provavelmente
            não o dos noivos no dia do evento.</p>
        </div>
    </section>
</Base>

<style>
    /* Cabeçalho mais baixo aqui do que nas outras páginas: esta é a página que vai ser
       aberta com pressa, no celular, e o bloco de corrida precisa caber acima da dobra. */
    .cabeca {
        display: flex;
        align-items: flex-end;
        min-block-size: 22svh;
        padding-block: calc(var(--e-5) + var(--e-3)) var(--e-3);
    }
    .cabeca__apoio {
        margin-block-start: var(--e-2);
        font-size: var(--t-sm);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--texto-suave);
    }

    h2 {
        margin-block-end: var(--e-2);
    }
    .sub {
        margin-block: var(--e-4) var(--e-1);
        font-size: var(--t-lg);
        text-transform: none;
    }

    .local__nome {
        font-family: var(--fonte-display);
        font-size: var(--t-lg);
        text-transform: uppercase;
    }
    .local__endereco {
        margin-block-start: 0.4em;
        font-style: normal;
        line-height: 1.7;
    }
    .local__quando {
        margin-block-start: var(--e-2);
        font-size: var(--t-sm);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--texto-suave);
    }

    .rotas {
        margin-block-start: var(--e-3);
        padding-inline-start: 1.2em;
        display: grid;
        gap: var(--e-2);
    }
    .rotas h3 {
        font-size: var(--t-base);
        text-transform: none;
        font-family: var(--fonte-texto);
        font-weight: 600;
    }
    .rotas p {
        font-size: var(--t-sm);
        color: var(--texto-suave);
    }

    /* A nav é fixa e tem ~140px no desktop; a seção já tem --e-6 de respiro antes do título.
       Com --e-4 o título parava 4px embaixo da nav (medido); --e-6 deixa ~50px de folga. */
    .traje {
        scroll-margin-block-start: var(--e-6);
    }
    /* O que o convidado veio buscar: a primeira coisa lida depois do título. */
    .traje__codigo {
        margin-block-end: var(--e-2);
        font-family: var(--fonte-display);
        font-size: var(--t-xl);
        line-height: 1;
        text-transform: uppercase;
    }

    /* Cartão creme sobre a faixa areia. O --bg acompanha, para quem herdar a cor de fundo. */
    .loja {
        --bg: var(--creme);
        max-inline-size: var(--largura-texto);
        padding: var(--e-3);
        background: var(--bg);
        border: 1px solid var(--borda);
        border-radius: var(--raio);
    }
    .loja__nome {
        font-family: var(--fonte-display);
        font-size: var(--t-lg);
        text-transform: uppercase;
    }
    .loja__oferece,
    .loja__apoio {
        font-size: var(--t-sm);
        color: var(--texto-suave);
    }
    .loja__apoio {
        margin-block-start: var(--e-2);
    }
    .loja__descontos {
        display: flex;
        flex-wrap: wrap;
        gap: var(--e-3);
        margin-block-start: var(--e-1);
        padding: 0;
        list-style: none;
    }
    .loja__descontos li {
        display: flex;
        align-items: baseline;
        gap: 0.4em;
    }
    /* Texto em --texto (oliva), nunca --laranja: laranja sobre creme dá 2:1. */
    .loja__pct {
        font-family: var(--fonte-display);
        font-size: var(--t-xl);
        line-height: 1;
    }
    .loja__cond {
        font-size: var(--t-sm);
    }
    .loja__endereco {
        margin-block-start: var(--e-2);
        font-style: normal;
        line-height: 1.7;
    }
    .loja__links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5em;
        margin-block-start: var(--e-1);
        margin-inline-start: -0.5rem;
        font-size: var(--t-sm);
    }
    /* Mesmo alvo de toque dos links de mapa do ComoChegar. */
    .loja__links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4em;
        min-block-size: 44px;
        min-inline-size: 44px;
        padding-inline: 0.5rem;
    }
    .loja__contato {
        margin-block-start: var(--e-1);
        font-size: var(--t-sm);
        color: var(--texto-suave);
    }

    .pendencia {
        margin-block-start: var(--e-2);
        padding: var(--e-2);
        border-inline-start: 3px solid var(--laranja-texto);
        background: color-mix(in srgb, var(--laranja) 10%, transparent);
        font-size: var(--t-sm);
        max-inline-size: var(--largura-texto);
    }

    .duvidas {
        max-inline-size: var(--largura-texto);
    }
</style>
